{
  "name": "wms-mcp-tenant-guard-demo",
  "version": "0.1.0",
  "description": "Minimal MCP server for a multi-tenant warehouse system: tenant from the token, idempotent audited writes, no outbound channels. Fake data only.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server/http.ts",
    "token": "node scripts/mint-dev-token.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
